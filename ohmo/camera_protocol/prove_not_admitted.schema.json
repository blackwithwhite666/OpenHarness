{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.yandex-team.ru/dropbox_camera_prove_not_admitted_v1.schema.json",
  "title": "Camera prove-not-admitted response",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "proof", "request_identity", "current_lease"],
  "properties": {
    "status": {"const": "not_admitted"},
    "proof": {"const": "same_session_durable_journal_v1"},
    "request_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id", "source_revision", "manifest_sha256", "image_sha256",
        "capture_time", "capture_time_authority", "session_id", "epoch", "seq"
      ],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^dropbox-camera-v1-[0-9a-f]{64}$"},
        "source_revision": {"type": "string", "minLength": 1, "maxLength": 256},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "image_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "capture_time": {"type": "string", "format": "date-time"},
        "capture_time_authority": {"enum": ["exif", "filename"]},
        "session_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "epoch": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "seq": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}
      }
    },
    "current_lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "epoch", "committed_seq", "expires_at"],
      "properties": {
        "session_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "epoch": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "committed_seq": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
