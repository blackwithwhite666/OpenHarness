# Task-scoped runner. OpenHarness dependencies come only from this exact uv.lock;
# Telegent's unconditional fixture imports use exact versions in its poetry.lock.
FROM ghcr.io/astral-sh/uv:0.9.24 AS uv
FROM python:3.12-slim
COPY --from=uv /uv /uvx /bin/
RUN apt-get update && apt-get install -y --no-install-recommends git=1:2.47.3-0+deb13u1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/build
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY ohmo ./ohmo
RUN uv sync --frozen --extra dev --no-install-project
RUN uv pip install --python /opt/build/.venv/bin/python --no-deps \
    'deepseek-tokenizer==0.1.3' \
    'lxml==6.1.3' \
    'rocksdict==0.3.28' \
    'ruamel.yaml==0.18.16' \
    'ruamel.yaml.clib==0.2.15' \
    'tokenizers==0.22.1' \
    'fastapi==0.141.1' \
    'prometheus-client==0.25.0'
RUN ln -s /opt/build/.venv /opt/venv
WORKDIR /openharness
CMD ["/opt/venv/bin/python", "tests/camera_e2e_probe/run_joined.py"]
