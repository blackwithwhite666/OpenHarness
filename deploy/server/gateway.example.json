{
  "provider_profile": "codex",
  "enabled_channels": ["telegram"],
  "session_routing": "chat-thread",
  "send_progress": true,
  "send_tool_hints": true,
  "debug_progress_chats": [],
  "permission_mode": "default",
  "sandbox_enabled": false,
  "log_level": "INFO",
  "channel_configs": {
    "telegram": {
      "enabled": true,
      "voice_transcription_enabled": false,
      "voice_transcription_argv": ["elevenlabs-cli", "asr", "--timestamps", "none", "--json"],
      "voice_transcription_timeout_seconds": 60.0,
      "voice_transcription_max_attempts": 2,
      "voice_transcription_base_backoff_seconds": 0.5,
      "voice_transcription_total_budget_seconds": 90.0
    }
  },
  "default_tz": "Europe/Moscow",
  "memory_backend": "file",
  "conversation_learning": true,
  "honcho_base_url": "${HONCHO_BASE_URL}",
  "owner_principals": [],
  "family_principals": {
    "999999999": "marina"
  },
  "enabled_memory_tenants": ["marina"],
  "tenant_honcho": {
    "marina": {
      "workspace": "${MARINA_HONCHO_WORKSPACE}",
      "api_key": "${MARINA_HONCHO_API_KEY}",
      "session": "ohmo",
      "observed_peer": "${MARINA_HONCHO_OBSERVED_PEER}"
    }
  },
  "camera_ingress": {
    "enabled": true,
    "listen_host": "10.8.0.8",
    "listen_port": 18751,
    "bearer_token_file": "${CAMERA_API_TOKEN_FILE}",
    "synchronized_root": "${CAMERA_SHARED_DROPBOX_ROOT}",
    "principal": "${CAMERA_TELEGRAM_PRINCIPAL}",
    "tenant_id": "${CAMERA_TENANT_ID}",
    "chat_id": "${CAMERA_TELEGRAM_PRIVATE_CHAT_ID}",
    "session_key": "telegram:${CAMERA_TELEGRAM_PRINCIPAL}"
  }
}
